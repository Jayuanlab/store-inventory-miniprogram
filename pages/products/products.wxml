<view class="page"><view class="page-head"><view class="page-title">商品资料</view><button class="icon-btn" bindtap="add" aria-label="新增商品"><image class="icon" src="/assets/icons/plus.svg"/></button></view>
 <view class="error" wx:if="{{error && !editor}}">{{error}}</view><view class="search"><image class="icon" src="/assets/icons/search.svg"/><input value="{{keyword}}" bindinput="search" placeholder="商品名称或编号"/></view>
 <view class="surface"><view class="row line" wx:for="{{filtered}}" wx:key="skuId" data-id="{{item.skuId}}" bindtap="edit"><view class="grow"><view class="item-name">{{item.name}}</view><view class="subtle">{{item.type}} · {{item.stockManaged === false ? '服务商品' : (item.trackSerial ? '串码库存' : '数量库存')}}</view></view><image class="small-icon" src="/assets/icons/pencil.svg"/></view><view class="empty" wx:if="{{!filtered.length}}">暂无匹配商品</view></view>
 <view class="sheet-backdrop" wx:if="{{editor}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="page-head"><view class="page-title">{{editor.skuId ? '编辑商品' : '新增商品'}}</view><button class="icon-btn" bindtap="close"><image class="icon" src="/assets/icons/x.svg"/></button></view>
 <view class="field"><text class="label">商品名称</text><input class="input" value="{{editor.name}}" data-field="name" bindinput="field"/></view><view class="field"><text class="label">商品编号</text><input class="input" value="{{editor.externalCode}}" data-field="externalCode" bindinput="field"/></view>
 <view class="field-pair"><view class="field"><text class="label">分类</text><input class="input" value="{{editor.type}}" data-field="type" bindinput="field" placeholder="手机、号卡、配件、维修"/></view><view class="field"><text class="label">简称</text><input class="input" value="{{editor.shortName}}" data-field="shortName" bindinput="field"/></view></view>
 <view class="field"><text class="label">管理方式</text><picker range="{{kinds}}" value="{{editor.kindIndex}}" bindchange="kind"><view class="picker-value">{{kinds[editor.kindIndex]}}</view></picker></view>
 <view class="field-pair"><view class="field"><text class="label">单位</text><input class="input" value="{{editor.unit}}" data-field="unit" bindinput="field"/></view><view class="field"><text class="label">预设售价（元）</text><input class="input" type="digit" value="{{editor.salePrice}}" data-field="salePrice" bindinput="field"/></view></view>
 <view class="error" wx:if="{{error}}">{{error}}</view><view class="actions"><button class="primary-btn" bindtap="save" loading="{{submitting}}" disabled="{{submitting}}">保存商品</button></view>
 </view></view>
</view>
