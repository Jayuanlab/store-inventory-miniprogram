<view class="page supplier-page">
  <view class="page-head"><view class="grow"><view class="page-title">{{supplier.name || '供应商往来'}}</view><view class="subtle">{{supplier.contact}}</view></view><button class="icon-btn" wx:if="{{caps.purchase}}" data-kind="profile" bindtap="edit" aria-label="修改供应商资料"><image class="icon" src="/assets/icons/pencil.svg"/></button></view>
  <view class="error" wx:if="{{error && !editor && !selectedLog}}">{{error}}<button class="text-btn" bindtap="reload">重试</button></view>
  <view class="surface"><view class="summary-grid">
    <view><view class="metric-label">我待付货款</view><view class="money negative">¥{{balances.payable || '0.00'}}</view></view>
    <view><view class="metric-label">对方应退 / 应付</view><view class="money blue">¥{{balances.cash || '0.00'}}</view></view>
    <view><view class="metric-label">预付余额</view><view class="money">¥{{balances.advance || '0.00'}}</view></view>
    <view><view class="metric-label">仅抵货款额度</view><view class="money">¥{{balances.credit || '0.00'}}</view></view>
  </view></view>
  <view class="command-row" wx:if="{{caps.supplierSettle}}"><button class="secondary-btn" bindtap="edit" data-kind="payment"><image class="small-icon" src="/assets/icons/wallet.svg"/>付款</button><button class="secondary-btn" bindtap="edit" data-kind="refund"><image class="small-icon" src="/assets/icons/landmark.svg"/>收退款</button><button class="secondary-btn" bindtap="edit" data-kind="offset"><image class="small-icon" src="/assets/icons/receipt-text.svg"/>抵货款</button></view>
  <view class="segmented"><view class="segment {{tab === 'open' ? 'active' : ''}}" data-tab="open" bindtap="changeTab">待结款项</view><view class="segment {{tab === 'ledger' ? 'active' : ''}}" data-tab="ledger" bindtap="changeTab">往来明细</view><view class="segment {{tab === 'goods' ? 'active' : ''}}" data-tab="goods" bindtap="changeTab">进退货</view><view class="segment {{tab === 'statement' ? 'active' : ''}}" data-tab="statement" bindtap="changeTab">对账单</view></view>
  <block wx:if="{{tab === 'open'}}">
    <view class="surface"><view class="line" wx:for="{{openEntries}}" wx:key="id" bindtap="showLog" data-id="{{item.id}}"><view class="row"><view class="grow"><text class="badge {{item.kind === 'payable' ? 'pending' : 'muted'}}">{{item.kindLabel}}</text><view class="item-name entry-title">{{item.title}}</view></view><view class="right"><view class="money {{item.kind === 'payable' ? 'negative' : item.kind === 'cash' ? 'blue' : ''}}">¥{{item.remainingText}}</view><view class="subtle">原额 ¥{{item.amountText}}</view></view></view><view class="subtle">{{item.timeText}}</view><view class="subtle" wx:if="{{item.dueDate}}">付款到期 {{item.dueDate}}</view></view><view class="empty" wx:if="{{!openEntries.length}}">{{loading ? '正在读取往来' : '当前没有未结款项'}}</view></view>
    <view class="actions" wx:if="{{caps.opening && !entries.length && !supplier.openingRecorded}}"><button class="secondary-btn" data-kind="opening" bindtap="edit">登记期初往来</button></view>
    <view class="section-title" wx:if="{{caps.supplierAdjust}}">往来业务</view><view class="surface" wx:if="{{caps.supplierAdjust}}"><view class="menu-item" bindtap="adjust" data-mode="price"><image class="icon" src="/assets/icons/sliders-horizontal.svg"/><text class="grow">调价补差</text><image class="small-icon" src="/assets/icons/chevron-right.svg"/></view><view class="menu-item" data-kind="adjustment" bindtap="edit"><image class="icon" src="/assets/icons/receipt-text.svg"/><text class="grow">往来更正</text><image class="small-icon" src="/assets/icons/chevron-right.svg"/></view></view>
  </block>
  <block wx:if="{{tab === 'ledger'}}"><view class="surface"><view class="line row" wx:for="{{logs}}" wx:key="id" data-id="{{item.id}}" bindtap="showLog"><view class="grow"><view class="item-name">{{item.label}}</view><view class="subtle">{{item.subtitle}}</view><view class="subtle">{{item.timeText}} · {{item.operator}}</view></view><view class="right money">¥{{item.amountText}}</view></view><view class="empty" wx:if="{{!logs.length}}">暂无往来明细</view></view></block>
  <block wx:if="{{tab === 'goods'}}">
    <view class="actions"><button class="secondary-btn" bindtap="purchase" wx:if="{{caps.purchase}}"><image class="small-icon" src="/assets/icons/package-plus.svg"/>进货 / 订货</button><button class="secondary-btn" bindtap="adjust" data-mode="return" wx:if="{{caps.supplierAdjust}}">采购退货</button></view>
    <view class="section-title" wx:if="{{plans.length}}">订货记录</view><view class="surface" wx:if="{{plans.length}}"><view class="line" wx:for="{{plans}}" wx:key="id"><view class="row"><text class="grow item-name">{{item.names}}</text><text class="badge muted">{{item.statusText}}</text></view><view class="subtle">{{item.timeText}} · 待收 {{item.remaining}} 件</view><view class="row" wx:if="{{item.status === 'open' && caps.purchase}}"><button class="text-btn" data-plan="{{item.id}}" bindtap="purchase">登记到货</button><button class="text-btn" data-id="{{item.id}}" bindtap="closePlan">终止余货</button></view></view></view>
    <view class="section-title">进货记录</view><view class="surface"><view class="line" wx:for="{{purchases}}" wx:key="id"><view class="row"><view class="grow"><view class="item-name">{{item.names}}</view><view class="subtle">{{item.timeText}} · {{item.operator}}</view></view><view class="right"><view class="money">¥{{item.amountText}}</view><view class="subtle">待结 ¥{{item.dueText}}</view></view></view><view class="mono subtle">{{item.id}}</view></view><view class="empty" wx:if="{{!purchases.length}}">暂无进货记录</view></view>
    <view class="section-title" wx:if="{{returns.length}}">采购退货</view><view class="surface" wx:if="{{returns.length}}"><view class="line row" wx:for="{{returns}}" wx:key="id"><view class="grow"><view class="item-name">{{item.name}} × {{item.quantity}}</view><view class="subtle">{{item.timeText}} · {{item.reference}}</view></view><text class="money">¥{{item.amountText}}</text></view></view>
  </block>
  <block wx:if="{{tab === 'statement'}}">
    <view class="date-range"><picker mode="date" value="{{from}}" bindchange="dateRange" data-field="from"><view class="picker-value">{{from}}</view></picker><text class="subtle">至</text><picker mode="date" value="{{to}}" bindchange="dateRange" data-field="to"><view class="picker-value">{{to}}</view></picker><button class="icon-btn" aria-label="导出Excel对账单" bindtap="exportStatement" loading="{{exporting}}" disabled="{{exporting}}"><image class="icon" src="/assets/icons/file-spreadsheet.svg"/></button></view>
    <view class="surface"><view class="statement-row line subtle"><text>往来类别</text><text>期初</text><text>期末</text></view><view class="statement-row line" wx:for="{{statement.balances}}" wx:key="key"><text>{{item.label}}</text><text>{{item.opening}}</text><text>{{item.closing}}</text></view></view>
    <view class="section-title">期间往来</view><view class="surface"><view class="line row" wx:for="{{statement.rows}}" wx:key="id"><view class="grow"><view class="item-name">{{item.type}} {{item.kind || ''}}</view><view class="subtle">{{item.date}}</view></view><view class="right">¥{{item.amountText}}</view></view><view class="empty" wx:if="{{!statement.rows.length}}">所选期间没有往来变动</view></view>
    <view class="section-title">实际收付</view><view class="surface"><view class="line row" wx:for="{{statement.cash}}" wx:key="id"><view class="grow"><view>{{item.type === 'payment' ? '付款' : '收回退款'}} · {{item.account}}</view><view class="subtle">{{item.date}}</view></view><view class="right">{{item.amountText}}</view></view><view class="empty" wx:if="{{!statement.cash.length}}">所选期间没有实际收付</view></view>
  </block>
</view>
<view class="sheet-backdrop" wx:if="{{editor}}" bindtap="close"><view class="sheet" catchtap="noop">
  <view class="page-head"><view class="page-title">{{editor.title}}</view><button class="icon-btn" bindtap="close" aria-label="关闭"><image class="icon" src="/assets/icons/x.svg"/></button></view>
  <block wx:if="{{editor.kind === 'profile'}}"><view class="field"><text class="label">供应商 / 结算主体</text><input class="input" value="{{editor.name}}" data-field="name" bindinput="field"/></view><view class="field"><text class="label">联系人及电话</text><input class="input" value="{{editor.contact}}" data-field="contact" bindinput="field"/></view></block>
  <block wx:if="{{editor.kind === 'payment'}}">
    <view class="field" wx:if="{{paymentPlans.length > 1}}"><text class="label">关联订货预付（选填）</text><picker class="payment-plan-picker" range="{{paymentPlans}}" range-key="optionLabel" value="{{paymentPlanIndex}}" bindchange="paymentPlan"><view class="picker-value">{{paymentPlans[paymentPlanIndex].optionLabel}}</view></picker></view>
    <block wx:if="{{!editor.planId}}"><view class="label">本次结哪些货款（可多选）</view><checkbox-group bindchange="dueSelection"><label class="due-row" wx:for="{{targets}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#147957"/><view class="grow"><view>{{item.title}} · ¥{{item.remainingText}}</view><view class="subtle">{{item.timeText}} · {{item.sourceId}}</view></view></label></checkbox-group><view class="subtle" wx:if="{{!targets.length}}">暂无待付货款</view></block>
  </block>
  <block wx:if="{{editor.kind === 'refund' || editor.kind === 'offset'}}"><view class="field"><text class="label">{{editor.kind === 'refund' ? '退回哪笔款项' : '使用哪笔款项抵扣'}}</text><picker range="{{sources}}" range-key="optionLabel" value="{{sourceIndex}}" bindchange="source"><view class="picker-value">{{sources[sourceIndex].optionLabel || '暂无可用款项'}}</view></picker></view></block>
  <view class="field" wx:if="{{editor.kind === 'offset'}}"><text class="label">抵哪笔待付货款</text><picker range="{{targets}}" range-key="optionLabel" value="{{targetIndex}}" bindchange="target"><view class="picker-value">{{targets[targetIndex].optionLabel || '暂无待付货款'}}</view></picker></view>
  <block wx:if="{{editor.kind === 'opening'}}"><view class="field-pair"><view class="field"><text class="label">我待付（元）</text><input class="input" type="digit" value="{{editor.payable}}" data-field="payable" bindinput="field" placeholder="0.00"/></view><view class="field"><text class="label">对方应退（元）</text><input class="input" type="digit" value="{{editor.cash}}" data-field="cash" bindinput="field" placeholder="0.00"/></view><view class="field"><text class="label">预付余额（元）</text><input class="input" type="digit" value="{{editor.advance}}" data-field="advance" bindinput="field" placeholder="0.00"/></view><view class="field"><text class="label">仅抵额度（元）</text><input class="input" type="digit" value="{{editor.credit}}" data-field="credit" bindinput="field" placeholder="0.00"/></view></view></block>
  <block wx:if="{{editor.kind === 'adjustment'}}"><view class="label">增加的往来余额</view><radio-group class="radio-list" bindchange="adjustmentKind"><label><radio value="payable" checked="{{editor.entryKind === 'payable'}}" color="#147957"/>我待付</label><label><radio value="cash" checked="{{editor.entryKind === 'cash'}}" color="#147957"/>对方应退</label><label><radio value="credit" checked="{{editor.entryKind === 'credit'}}" color="#147957"/>仅抵货款</label></radio-group><view class="field"><text class="label">双方确认编号</text><input class="input" value="{{editor.reference}}" data-field="reference" bindinput="field"/></view></block>
  <view class="field" wx:if="{{editor.kind !== 'opening' && editor.kind !== 'profile'}}"><text class="label">{{editor.kind === 'payment' ? '本次实际付款' : editor.kind === 'refund' ? '本次实际收到' : '本次金额'}}（元）</text><input class="input amount-input" type="digit" value="{{editor.amount}}" data-field="amount" bindinput="field" placeholder="0.00"/></view>
  <view class="row line subtle" wx:if="{{editor.kind === 'payment'}}"><text>结货款 ¥{{allocationTotal}}</text><text>留作预付 ¥{{unallocated}}</text></view>
  <view class="field-pair" wx:if="{{editor.kind === 'payment' || editor.kind === 'refund'}}"><view class="field"><text class="label">实际账户</text><picker range="{{accounts}}" bindchange="account"><view class="picker-value">{{account}}</view></picker></view><view class="field"><text class="label">实际收付日期</text><picker mode="date" value="{{editor.date}}" end="{{today}}" bindchange="editorDate"><view class="picker-value">{{editor.date}}</view></picker></view></view>
  <view class="field" wx:if="{{editor.kind === 'opening'}}"><text class="label">期初日期</text><picker mode="date" value="{{editor.date}}" bindchange="editorDate"><view class="picker-value">{{editor.date}}</view></picker></view>
  <view class="field"><text class="label">{{editor.kind === 'opening' || editor.kind === 'adjustment' ? '双方核对依据 / 原因' : '备注 / 约定'}}</text><textarea class="input note-input" value="{{editor.note}}" data-field="note" bindinput="field" auto-height maxlength="1000"/></view>
  <view class="error" wx:if="{{error}}">{{error}}</view><button class="primary-btn" bindtap="save" loading="{{submitting}}" disabled="{{submitting || ((editor.kind === 'refund' || editor.kind === 'offset') && !sources.length) || (editor.kind === 'offset' && !targets.length)}}">{{editor.kind === 'payment' ? '确认已付款' : editor.kind === 'refund' ? '确认已到账' : editor.kind === 'offset' ? '确认抵货款' : '确认保存'}}</button>
</view></view>
<view class="sheet-backdrop" wx:if="{{selectedLog}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="page-head"><view class="page-title">{{selectedLog.label}}</view><button class="icon-btn" aria-label="关闭" bindtap="close"><image class="icon" src="/assets/icons/x.svg"/></button></view><view class="money">¥{{selectedLog.amountText}}</view><view class="subtle line">{{selectedLog.timeText}} · {{selectedLog.operator}}</view><view class="line" wx:if="{{selectedLog.logType === 'entry'}}"><view>{{selectedLog.kindLabel}} · 未结 ¥{{selectedLog.remainingText}}</view><view class="mono subtle">来源 {{selectedLog.sourceId || selectedLog.id}}</view></view><view class="line" wx:else><view class="subtle">抵扣来源</view><view>{{selectedLog.sourceText}}</view><view class="subtle">结清对象</view><view>{{selectedLog.targetText}}</view></view><view class="line" wx:if="{{selectedLog.price}}"><view class="row"><text>库存成本变化</text><text>¥{{selectedLog.price.inventoryText}}</text></view><view class="row"><text>已售成本变化</text><text>¥{{selectedLog.price.salesText}}</text></view><view class="subtle">确认编号 {{selectedLog.price.reference}}</view></view><view class="line" wx:if="{{selectedLog.note}}">{{selectedLog.note}}</view><view class="line" wx:for="{{selectedLog.matches}}" wx:key="id"><view class="row"><text>{{item.label}}</text><text>¥{{item.amountText}}</text></view><view class="subtle">{{item.timeText}}</view></view><view class="error" wx:if="{{error}}">{{error}}</view><button class="danger-btn" wx:if="{{caps.supplierSettle && (selectedLog.type === 'offset' || selectedLog.type === 'payment') && !selectedLog.reversedAt && !selectedLog.legacy}}" bindtap="reverse" disabled="{{submitting}}">{{selectedLog.type === 'payment' ? '撤销这笔付款分配' : '撤销这笔抵扣'}}</button></view></view>
