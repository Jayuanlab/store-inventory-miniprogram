<view class="page"><view class="page-head"><view class="page-title">收支账款</view><button class="text-btn" bindtap="expense">记费用</button></view>
 <view class="error" wx:if="{{error && !editor}}">{{error}}<button class="text-btn" bindtap="reload">重试</button></view>
 <view class="surface" wx:if="{{caps.supplierView}}"><view class="menu-item" bindtap="go" data-url="/pages/suppliers/suppliers"><image class="icon" src="/assets/icons/contact-round.svg"/><text class="grow item-name">供应商往来</text><image class="small-icon" src="/assets/icons/chevron-right.svg"/></view><view class="summary-grid"><view><view class="metric-label">我待付货款</view><view class="money negative">¥{{payableText}}</view></view><view><view class="metric-label">对方应退 / 应付</view><view class="money blue">¥{{supplierCashText}}</view></view><view><view class="metric-label">预付货款余额</view><view class="money">¥{{supplierAdvanceText}}</view></view><view><view class="metric-label">仅抵货款额度</view><view class="money">¥{{supplierCreditText}}</view></view></view></view>
 <view class="section-title">收支流水</view><view class="surface"><view class="line row" wx:for="{{receipts}}" wx:key="id"><view class="grow"><view class="item-name">{{item.label}}</view><view class="subtle">{{item.account}} · {{item.timeText}}</view></view><view class="money {{item.amount < 0 ? 'negative' : 'primary'}}">{{item.amountText}}</view></view><view class="empty" wx:if="{{!receipts.length}}">{{loading ? '正在读取' : '暂无收支记录'}}</view></view>
 <view class="sheet-backdrop" wx:if="{{editor}}" bindtap="close"><view class="sheet" catchtap="noop"><view class="page-head"><view class="page-title">{{editor.kind === 'expense' ? '记录费用' : '支付货款'}}</view><button class="icon-btn" bindtap="close"><image class="icon" src="/assets/icons/x.svg"/></button></view><view class="field"><text class="label">{{editor.kind === 'expense' ? '费用名称' : '供应商'}}</text><input class="input" value="{{editor.type}}" data-field="type" bindinput="field" disabled="{{editor.kind !== 'expense'}}"/></view><view class="field"><text class="label">本次金额（元）</text><input class="input" type="digit" value="{{editor.amount}}" data-field="amount" bindinput="field"/></view><view class="field"><text class="label">付款账户</text><picker range="{{accounts}}" bindchange="account"><view class="picker-value">{{account}}</view></picker></view><view class="error" wx:if="{{error}}">{{error}}</view><button class="primary-btn" bindtap="save" disabled="{{submitting}}" loading="{{submitting}}">确认已付款</button></view></view>
</view>
