<view class="page">
  <view class="page-head"><view><view class="page-title">{{mode === 'price' ? '调价补差' : '采购退货'}}</view><view class="subtle">{{supplier.name}}</view></view></view>
  <view class="error" wx:if="{{error}}">{{error}}<button class="text-btn" bindtap="reload" wx:if="{{!selected}}">重试</button></view>
  <block wx:if="{{!selected}}"><view class="search"><image class="icon" src="/assets/icons/search.svg"/><input value="{{keyword}}" bindinput="search" placeholder="搜索原进货商品、串码、单号"/></view><view class="surface"><view class="line" wx:for="{{results}}" wx:key="itemId" bindtap="choose" data-id="{{item.itemId}}"><view class="row"><view class="grow item-name">{{item.name}}</view><image class="small-icon" src="/assets/icons/chevron-right.svg"/></view><view class="subtle">{{item.timeText}} · 进货 {{item.quantity}} 件 · 原单价 ¥{{item.priceText}}</view><view class="mono subtle">{{item.purchaseId}}</view></view><view class="empty" wx:if="{{!results.length}}">{{loading ? '正在读取进货记录' : '没有匹配的进货明细'}}</view></view></block>
  <block wx:else>
    <view class="surface"><view class="line row"><view class="grow"><view class="item-name">{{selected.name}}</view><view class="subtle">{{selected.timeText}} · 原进货 {{selected.quantity}} 件</view></view><button class="text-btn" bindtap="clear" disabled="{{submitting || previewing}}">重选</button></view></view>
    <block wx:if="{{mode === 'price'}}">
      <view class="field"><text class="label">调整方向</text><radio-group class="radio-list" bindchange="field" data-field="direction"><label><radio value="decrease" checked="{{direction === 'decrease'}}" color="#147957"/>降价补差</label><label><radio value="increase" checked="{{direction === 'increase'}}" color="#147957"/>追加进价</label></radio-group></view>
      <view class="field"><text class="label">协议适用范围</text><radio-group class="radio-stack" bindchange="field" data-field="scope"><label><radio value="inventory" checked="{{scope === 'inventory'}}" color="#147957"/>当前在库</label><label><radio value="all" checked="{{scope === 'all'}}" color="#147957"/>本批全部（含已售）</label><label wx:if="{{selected.trackSerial}}"><radio value="selected" checked="{{scope === 'selected'}}" color="#147957"/>指定串码</label></radio-group></view>
      <view class="field"><text class="label">本次每件{{direction === 'decrease' ? '补差' : '追加'}}（元）</text><input class="input" type="digit" value="{{unitAmount}}" data-field="unitAmount" bindinput="field" placeholder="0.00"/></view>
    </block>
    <view class="field" wx:if="{{selected.trackSerial && (scope === 'selected' || mode === 'return')}}"><text class="label">{{mode === 'return' ? '退回串码' : '补差串码'}} · 已选 {{serialNos.length}} 件</text><checkbox-group bindchange="selectSerial"><label class="serial-row" wx:for="{{selected.serials}}" wx:key="no"><checkbox value="{{item.no}}" checked="{{item.checked}}" color="#147957"/><view class="grow"><view class="mono">{{item.no}}</view><view class="subtle">{{item.status}} · 当前成本 ¥{{item.costPrice}}</view></view></label></checkbox-group><view class="empty" wx:if="{{!selected.serials.length}}">没有可选串码</view></view>
    <view class="field-pair" wx:if="{{mode === 'return'}}"><view class="field"><text class="label">退货数量</text><input class="input" type="number" value="{{quantity}}" data-field="quantity" bindinput="field" disabled="{{selected.trackSerial}}"/></view><view class="field"><text class="label">认可退款单价（元）</text><input class="input" type="digit" value="{{unitPrice}}" data-field="unitPrice" bindinput="field" placeholder="协议退款单价"/></view></view>
    <view class="field" wx:if="{{direction === 'decrease' || mode === 'return'}}"><text class="label">供应商确认的结算方式</text><radio-group class="radio-list" bindchange="field" data-field="kind"><label><radio value="cash" checked="{{kind === 'cash'}}" color="#147957"/>可退现金 / 可抵货款</label><label><radio value="credit" checked="{{kind === 'credit'}}" color="#147957"/>仅抵货款</label></radio-group></view>
    <view class="field"><text class="label">供应商确认编号</text><input class="input" value="{{reference}}" data-field="reference" bindinput="field" placeholder="对账单号或本次约定编号" maxlength="100"/></view>
    <view class="field"><text class="label">双方确认依据 / 约定</text><textarea class="input note-input" value="{{note}}" data-field="note" bindinput="field" auto-height maxlength="1000"/></view>
    <button class="secondary-btn" bindtap="preview" loading="{{previewing}}" disabled="{{previewing || submitting}}">计算并预览</button>
    <block wx:if="{{preview}}"><view class="section-title">本次确认结果</view><view class="surface"><view class="line row"><text>确认金额</text><text class="money">¥{{preview.amountText}}</text></view>
      <block wx:if="{{mode === 'price'}}"><view class="line row"><text>库存成本变化</text><text>¥{{preview.inventoryText}}</text></view><view class="line row"><text>已售 / 耗材成本变化</text><text>¥{{preview.salesText}}</text></view><view class="line row"><text>已售毛利变化</text><text class="blue">¥{{preview.profitText}}</text></view><view class="line row"><text>工资处理</text><text class="subtle">原工资不变</text></view></block>
      <view class="line row" wx:else><text>本次出库成本</text><text>¥{{preview.costText}}</text></view>
      <view class="line row"><text>往来类型</text><text>{{mode === 'price' && direction === 'increase' ? '我待付货款' : kind === 'credit' ? '仅抵货款额度' : '对方应退款'}}</text></view>
    </view><view class="actions"><button class="primary-btn" bindtap="confirm" loading="{{submitting}}" disabled="{{submitting}}">{{mode === 'price' ? '确认调价入账' : '确认退货出库与款项'}}</button></view>
    <button class="text-btn" wx:if="{{preview.targets.length}}" bindtap="toggleTargets">{{showTargets ? '收起成本明细' : '展开成本明细'}}（{{preview.targets.length}}条）</button><view class="surface" wx:if="{{showTargets}}"><view class="line" wx:for="{{preview.targets}}" wx:key="key"><view class="row"><text class="grow subtle">{{item.label}} · {{item.quantityText}} 件成本份额</text><text>¥{{item.amountText}}</text></view><view class="mono subtle" wx:if="{{item.serialNo}}">{{item.serialNo}}</view><button class="text-btn" wx:if="{{item.orderId}}" bindtap="go" data-url="/pages/orders/orders?id={{item.orderId}}">{{item.name}} · 查看销售单</button></view></view></block>
  </block>
</view>
